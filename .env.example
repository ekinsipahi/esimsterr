# eSIMsterr — environment variables. Real values go in .env (never committed).

# --- Django ---
DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://127.0.0.1:8000
CANONICAL_HOST=esimsterr.com
REDIRECT_HOSTS=www.esimsterr.com,esimsterr.onrender.com

# --- Database (Supabase Postgres — session pooler, port 5432) ---
# DB_USER for the Supabase pooler is "postgres.<project-ref>" (Supabase → Connect).
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
# or a single URL instead of the parts above:
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- Yesim partner API (eSIM provider) ---
YESIM_API_TOKEN=
YESIM_API_BASE=https://partners-api.yesim.biz
# Random string; the provider notification URL becomes /webhooks/yesim/<secret>/
YESIM_WEBHOOK_SECRET=

# --- Pricing (wholesale EUR → retail USD) ---
EUR_USD_RATE=1.10
PRICING_MARKUP=1.65
PRICING_MIN_MARGIN_USD=0.60
PRICING_MIN_PRICE_USD=1.49

# --- Stripe (card) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- NOWPayments (crypto) ---
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# --- Google sign-in (GIS) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=eSIMsterr <noreply@esimsterr.com>
SUPPORT_EMAIL=support@esimsterr.com
ADMIN_NOTIFY_EMAILS=

# --- Misc ---
GA_MEASUREMENT_ID=
CRON_SECRET=
SENTRY_DSN=
CORS_ALLOWED_ORIGINS=
APP_STORE_URL=
PLAY_STORE_URL=

# --- Languages -------------------------------------------------------------
# Comma-separated codes to actually serve. Every string in the project is
# translatable, but a locale should only go live once its .po file is really
# translated — publishing /tr/ pages full of English is duplicate content.
# Supported: en tr es pt fr de it ru ar fa hi id ms vi th ko ja zh-hans zh-hant
#            pl nl uk ro cs el sv he az kk uz bn ur
ENABLED_LANGUAGES=en

# --- Pricing: the struck-through list price --------------------------------
# List price = wholesale cost x this. Represents the going retail rate for the
# same data (the big eSIM apps run roughly 4x); the advertised percentage off is
# measured against it.
PRICING_COMPARE_MULTIPLIER=4.0

# --- Subscriptions (Stripe recurring, unlimited plans) ---------------------
SUBSCRIPTIONS_ENABLED=True
# Standing discount versus buying the same unlimited plan one-off. This is the
# reason to subscribe, so keep it visible in the UI.
SUBSCRIPTION_DISCOUNT_PCT=15

# --- In-site AI assistant (signed-in customers only) -----------------------
# Without a key the widget still renders and falls back to "the team has been
# notified", so nothing breaks when it is unset.
ASSISTANT_ENABLED=True
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-4-5-20251001
# Where ticket and escalation alerts land. Falls back to SUPPORT_EMAIL.
SUPPORT_FORWARD_EMAIL=
